<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Higiene - Distribuidora Frazão</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f9;
      margin: 0;
      padding: 20px;
    }
    h1 {
      text-align: center;
      color: #333;
    }
    .grid-produtos {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    .card-produto {
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 16px;
      width: 250px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .card-produto h3 {
      font-size: 1.1rem;
      color: #222;
      margin-top: 0;
    }
    .botoes {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 15px;
    }
    .btn {
      border: none;
      padding: 10px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      text-align: center;
      text-decoration: none;
      font-size: 0.9rem;
    }
    .btn-adicionar {
      background-color: #007bff;
      color: white;
    }
    .btn-adicionar:hover {
      background-color: #0056b3;
    }
    .btn-whatsapp {
      background-color: #25d366;
      color: white;
    }
    .btn-whatsapp:hover {
      background-color: #1eb954;
    }
  </style>
</head>
<body>

  <h1>🧼 Seção: Higiene</h1>

  <div class="grid-produtos">

    <!-- Produto 1 -->
    <div class="card-produto">
      <h3>Sabonete em Barra</h3>
      <div class="botoes">
        <button class="btn btn-adicionar" onclick="adicionarAoCarrinho('Sabonete em Barra')">Adicionar</button>
        <a class="btn btn-whatsapp" href="https://wa.me/5521968659086?text=Olá,%20gostaria%20de%20cotar%20o%20produto:%20Sabonete%20em%20Barra" target="_blank">Cotar no WhatsApp</a>
      </div>
    </div>

    <!-- Produto 2 -->
    <div class="card-produto">
      <h3>Creme Dental</h3>
      <div class="botoes">
        <button class="btn btn-adicionar" onclick="adicionarAoCarrinho('Creme Dental')">Adicionar</button>
        <a class="btn btn-whatsapp" href="https://wa.me/5521968659086?text=Olá,%20gostaria%20de%20cotar%20o%20produto:%20Creme%20Dental" target="_blank">Cotar no WhatsApp</a>
      </div>
    </div>

    <!-- Produto 3 -->
    <div class="card-produto">
      <h3>Shampoo</h3>
      <div class="botoes">
        <button class="btn btn-adicionar" onclick="adicionarAoCarrinho('Shampoo')">Adicionar</button>
        <a class="btn btn-whatsapp" href="https://wa.me/5521968659086?text=Olá,%20gostaria%20de%20cotar%20o%20produto:%20Shampoo" target="_blank">Cotar no WhatsApp</a>
      </div>
    </div>

    <!-- Produto 4 -->
    <div class="card-produto">
      <h3>Desodorante</h3>
      <div class="botoes">
        <button class="btn btn-adicionar" onclick="adicionarAoCarrinho('Desodorante')">Adicionar</button>
        <a class="btn btn-whatsapp" href="https://wa.me/5521968659086?text=Olá,%20gostaria%20de%20cotar%20o%20produto:%20Desodorante" target="_blank">Cotar no WhatsApp</a>
      </div>
    </div>

  </div>

  <script>
    function adicionarAoCarrinho(nomeProduto) {
      alert(nomeProduto + " foi adicionado ao seu carrinho!");
    }
  </script>

</body>
</html>
